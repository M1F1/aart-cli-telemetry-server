# Settings for `python -m deploy --target docker --environment deploy/environments/example-docker.env`.
# Names, addresses and references only: this file is meant to be committed, so it never holds a
# secret. A PostgreSQL URL goes in the file ENV_FILE names, which only the host reads.

IMAGE=aart-cli-telemetry-server:dev
# CONTAINER=aart-cli-telemetry-server
# DOCKER_CONTEXT=a-docker-context-for-the-host
# PUBLISH=127.0.0.1:8000
# VOLUME=aart-cli-telemetry
# ENV_FILE=/path/on/this/machine/telemetry.env
